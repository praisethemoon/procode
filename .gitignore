# Build outputs
node_modules/
cli/lap-cli/bin/
cli/kb-cli/bin/
cli/kb-cli/obj/
packages/kb-js/out/
packages/kb-mcp/out/
packages/index-vscode/out/
packages/lap-vscode/out/
packages/coboard/out/
packages/coboard-vscode/out/
packages/eggzibit/out/
packages/eggzibit-vscode/out/
packages/combined/dist/
*.vsix
*.o
*.plist
build/

# lap's own recorded history: the log is the truth, everything else in
# .lap/ is a disposable cache (index, sidecars, snapshots, shadows,
# state) that is native-endian and machine-local. Clone, then `lap
# rebuild` — exactly the transport story in cli/lap-cli/SPEC.md.
**/.lap/*
!**/.lap/log/
# the single-file log from before chunks, until lap's next write moves it
!**/.lap/log.jsonl

# Machine-local Claude Code settings (this one sets bypassPermissions,
# which should never be imposed on whoever clones the repo). The lap skill
# under .claude/skills/ IS part of the project and stays tracked.
.claude/settings.json
.claude/settings.local.json

# Written by "procode: Set Up MCP for Claude Code": absolute paths into this
# machine's VS Code and its installed extension, so it cannot be shared.
.mcp.json

# Dogfooding notes: useful locally, not part of the project's record.
feedback.md

# macOS
.DS_Store

# A scratch folder the VS Code launch configs open for testing.
.playground/
