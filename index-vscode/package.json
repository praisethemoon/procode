{
  "name": "index-vscode",
  "displayName": "Knowledge",
  "description": "The kb knowledge base as a reader's surface: find a document, read it, see where it came from.",
  "version": "0.1.0",
  "publisher": "praisethemoon",
  "author": {
    "name": "Soulaymen Chouri",
    "email": "doit@praisethemoon.org"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.kb/documents.jsonl",
    "onCustomEditor:knowledge.document"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "knowledge",
          "title": "Knowledge",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "knowledge": [
        {
          "id": "knowledge.documents",
          "name": "Knowledge",
          "type": "webview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "knowledge.document",
        "displayName": "Knowledge",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "kb:/*"
          },
          {
            "filenamePattern": "kb:///*"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "knowledge.open",
        "title": "Knowledge: Open Reference"
      },
      {
        "command": "knowledge.search",
        "title": "Knowledge: Search"
      },
      {
        "command": "knowledge.collections",
        "title": "Knowledge: Collections",
        "icon": "$(library)"
      },
      {
        "command": "knowledge.addCurrentFile",
        "title": "Knowledge: Add The Current File",
        "icon": "$(file-add)"
      },
      {
        "command": "knowledge.addUrl",
        "title": "Knowledge: Add A URL",
        "icon": "$(link)"
      },
      {
        "command": "knowledge.refreshStale",
        "title": "Knowledge: Refresh Stale Documents",
        "icon": "$(sync)"
      },
      {
        "command": "knowledge.init",
        "title": "Knowledge: Initialise A Store In This Workspace"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "knowledge.addCurrentFile",
          "when": "view == knowledge.documents",
          "group": "navigation@1"
        },
        {
          "command": "knowledge.addUrl",
          "when": "view == knowledge.documents",
          "group": "navigation@2"
        },
        {
          "command": "knowledge.refreshStale",
          "when": "view == knowledge.documents",
          "group": "navigation@3"
        },
        {
          "command": "knowledge.collections",
          "when": "view == knowledge.documents",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "knowledge.open",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Knowledge",
      "properties": {
        "knowledge.cliPath": {
          "type": "string",
          "default": "kb",
          "description": "The kb executable. A bare name is resolved through PATH."
        },
        "knowledge.staleAfterDays": {
          "type": "number",
          "default": 90,
          "minimum": 0,
          "description": "How old a document may be before the sidebar badges it stale. A search hit carries the store's own verdict and this does not override it."
        }
      }
    }
  },
  "scripts": {
    "deps": "node scripts/deps.mjs",
    "assets": "node scripts/assets.mjs",
    "bundle": "node scripts/bundle.mjs",
    "compile": "node scripts/deps.mjs && tsc -p ./ && tsc -p tsconfig.webview.json && npm run assets && npm run bundle",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "npm run compile && vsce package --allow-missing-repository",
    "verify:package": "npm run package && node scripts/packaged-smoke.mjs",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "baukasten-ui": "file:/Users/praisethemoon/code/baukasten/packages/baukasten",
    "kb-js": "file:../kb-js",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  }
}
