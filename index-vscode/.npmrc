# vsce resolves a symlink to its real path and would package `../kb-js/**` at
# paths outside the extension, so the installed .vsix would have no
# node_modules/kb-js and could not require it. A copy is what can be shipped.
#
# This setting belongs to the packages that produce a .vsix and must not leak
# sideways into a library, which wants the symlink: with a copy in place,
# rebuilding kb-js silently does not reach whoever installed it, and they then
# compile against a stale sibling and say nothing. `scripts/deps.mjs` closes
# both routes by which it leaks.
install-links=true
