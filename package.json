{
    "name": "lap-workspace",
    "private": true,
    "description": "procode: the TypeScript packages under packages/ are npm workspaces; the C tools under cli/ build with CMake, not npm.",
    "workspaces": [
        "packages/kb-js",
        "packages/kb-mcp",
        "packages/index-vscode",
        "packages/lap-vscode",
        "packages/coboard",
        "packages/coboard-vscode",
        "packages/artifacts",
        "packages/artifacts-vscode",
        "packages/combined"
    ],
    "scripts": {
        "setup": "npm install && npm run build",
        "build": "npm run compile --workspaces --if-present",
        "test": "npm test --workspaces --if-present",
        "package": "npm run package --workspace combined"
    }
}
