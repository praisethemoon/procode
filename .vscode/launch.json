{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Lap Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/lap-vscode",
        "--disable-extensions",
        "${workspaceFolder}/lap-vscode"
      ],
      "outFiles": ["${workspaceFolder}/lap-vscode/out/**/*.js"],
      "preLaunchTask": "npm: compile - lap-vscode"
    }
  ]
}
