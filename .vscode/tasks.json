{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: lap-cli",
      "type": "shell",
      "command": "make -C cli/lap-cli",
      "problemMatcher": "$gcc"
    },
    {
      "label": "build: kb-cli",
      "type": "shell",
      "command": "make -C cli/kb-cli",
      "problemMatcher": "$gcc"
    },
    {
      "label": "compile: lap-vscode",
      "type": "shell",
      "command": "npm run compile --workspace lap-vscode",
      "problemMatcher": "$tsc"
    },
    {
      "label": "compile: index-vscode",
      "type": "shell",
      "command": "npm run compile --workspace index-vscode",
      "problemMatcher": "$tsc"
    },
    {
      "label": "compile: coboard-vscode",
      "type": "shell",
      "command": "npm run compile --workspace coboard-vscode",
      "problemMatcher": "$tsc"
    },
    {
      "label": "compile: techdocs-vscode",
      "type": "shell",
      "command": "npm run compile --workspace techdocs-vscode",
      "problemMatcher": "$tsc"
    },
    {
      "label": "playground",
      "detail": "Creates .playground/ (gitignored) and seeds it with a board, lap sessions linked to its tickets, kb documents and techdocs pages; each part only when it is empty. Never deletes anything.",
      "type": "shell",
      "command": "npm run compile --workspace coboard && npm run compile --workspace techdocs && node scripts/playground.mjs",
      "dependsOn": [
        "build: lap-cli",
        "build: kb-cli"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "prepare: Lap History",
      "dependsOn": [
        "playground",
        "compile: lap-vscode"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "prepare: Knowledge",
      "dependsOn": [
        "playground",
        "compile: index-vscode"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "prepare: Board",
      "dependsOn": [
        "playground",
        "compile: coboard-vscode"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "prepare: techdocs",
      "dependsOn": [
        "playground",
        "compile: techdocs-vscode"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "prepare: all extensions",
      "dependsOn": [
        "playground",
        "compile: lap-vscode",
        "compile: index-vscode",
        "compile: coboard-vscode",
        "compile: techdocs-vscode"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "build: combined with ask",
      "detail": "Builds packages/combined/dist with ask in it (--with-ask): the one extension, with procode's own commands and the ask tab and server.",
      "type": "shell",
      "command": "node packages/combined/scripts/build.mjs --with-ask",
      "problemMatcher": []
    },
    {
      "label": "prepare: combined with ask",
      "dependsOn": [
        "playground",
        "build: combined with ask"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
