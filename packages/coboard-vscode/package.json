{
  "name": "coboard-vscode",
  "displayName": "Board",
  "description": "A small board of epics, milestones and tickets that developers and agents work on together, linked to lap sessions.",
  "version": "0.1.0",
  "private": true,
  "publisher": "praisethemoon",
  "author": {
    "name": "Soulaymen Chouri",
    "email": "doit@praisethemoon.org"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coboard",
          "title": "Board",
          "icon": "media/board.svg"
        }
      ]
    },
    "views": {
      "coboard": [
        {
          "id": "coboard.tree",
          "name": "Board",
          "type": "webview"
        }
      ]
    },
    "commands": [
      { "command": "coboard.newEpic", "title": "New Epic", "category": "Board", "icon": "$(add)" },
      { "command": "coboard.newMilestone", "title": "New Milestone", "category": "Board", "icon": "$(milestone)" },
      { "command": "coboard.newTicket", "title": "New Ticket", "category": "Board", "icon": "$(new-file)" },
      { "command": "coboard.open", "title": "Open", "category": "Board" },
      { "command": "coboard.delete", "title": "Delete", "category": "Board" },
      { "command": "coboard.archive", "title": "Archive…", "category": "Board", "icon": "$(archive)" },
      { "command": "coboard.unarchive", "title": "Unarchive", "category": "Board" },
      { "command": "coboard.close", "title": "Close", "category": "Board" },
      { "command": "coboard.reopen", "title": "Reopen", "category": "Board" },
      { "command": "coboard.startSession", "title": "Start lap Session for Ticket", "category": "Board" },
      { "command": "coboard.showEdit", "title": "Show lap Edit", "category": "Board" },
      { "command": "coboard.refresh", "title": "Refresh", "category": "Board", "icon": "$(refresh)" },
      { "command": "coboard.collapseAll", "title": "Collapse All", "category": "Board", "icon": "$(collapse-all)" }
    ],
    "menus": {
      "view/title": [
        { "command": "coboard.newEpic", "when": "view == coboard.tree", "group": "navigation@1" },
        { "command": "coboard.refresh", "when": "view == coboard.tree", "group": "navigation@2" },
        { "command": "coboard.collapseAll", "when": "view == coboard.tree", "group": "navigation@3" }
      ],
      "webview/context": [
        { "command": "coboard.open", "when": "webviewId == 'coboard.tree' && webviewSection =~ /^(epic|milestone|ticket)$/", "group": "0_open@1" },
        { "command": "coboard.newMilestone", "when": "webviewId == 'coboard.tree' && webviewSection == 'epic'", "group": "1_new@1" },
        { "command": "coboard.newTicket", "when": "webviewId == 'coboard.tree' && webviewSection =~ /^(epic|milestone)$/", "group": "1_new@2" },
        { "command": "coboard.startSession", "when": "webviewId == 'coboard.tree' && webviewSection == 'ticket'", "group": "2_lap@1" },
        { "command": "coboard.close", "when": "webviewId == 'coboard.tree' && webviewSection =~ /^(epic|milestone)$/ && !coboardDone", "group": "3_status@1" },
        { "command": "coboard.reopen", "when": "webviewId == 'coboard.tree' && webviewSection =~ /^(epic|milestone)$/ && coboardDone", "group": "3_status@1" },
        { "command": "coboard.archive", "when": "webviewId == 'coboard.tree' && webviewSection =~ /^(epic|milestone|ticket)$/ && !coboardArchived", "group": "8_archive@1" },
        { "command": "coboard.unarchive", "when": "webviewId == 'coboard.tree' && webviewSection =~ /^(epic|milestone|ticket)$/ && coboardArchived", "group": "8_archive@1" },
        { "command": "coboard.delete", "when": "webviewId == 'coboard.tree' && webviewSection =~ /^(epic|milestone|ticket)$/", "group": "9_delete@1" }
      ],
      "commandPalette": [
        { "command": "coboard.open", "when": "false" },
        { "command": "coboard.newMilestone", "when": "false" },
        { "command": "coboard.newTicket", "when": "false" },
        { "command": "coboard.delete", "when": "false" },
        { "command": "coboard.archive", "when": "false" },
        { "command": "coboard.unarchive", "when": "false" },
        { "command": "coboard.close", "when": "false" },
        { "command": "coboard.reopen", "when": "false" },
        { "command": "coboard.startSession", "when": "false" },
        { "command": "coboard.showEdit", "when": "false" },
        { "command": "coboard.collapseAll", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Board",
      "properties": {
        "coboard.author": {
          "type": "string",
          "default": "",
          "description": "The name your comments are signed with. Empty uses your OS user name."
        },
        "coboard.lapPath": {
          "type": "string",
          "default": "lap",
          "description": "The lap executable, for the sessions linked to a ticket."
        },
        "coboard.boardFolder": {
          "type": "string",
          "default": "",
          "description": "The folder whose board this window works (a folder holding .coboard/, or that .coboard/ itself), for one board across a project's folders. Empty: a lap branch folder uses its parent's board, any other folder the board found above it. Also handed to the board's MCP server as COBOARD_DIR."
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run compile --workspace coboard && tsc -p ./ && tsc -p tsconfig.webview.json && node scripts/build.mjs",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "baukasten-ui": "^0.3.0",
    "coboard": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  }
}
