{
  "name": "eggzibit-vscode",
  "displayName": "eggzibit",
  "description": "Pages agents publish into the workspace's .eggzibit/ directory, listed, filtered and rendered in the editor's theme through baukasten's design tokens.",
  "version": "0.1.0",
  "private": true,
  "publisher": "praisethemoon",
  "author": {
    "name": "Soulaymen Chouri",
    "email": "doit@praisethemoon.org"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "eggzibit",
          "title": "eggzibit",
          "icon": "media/eggzibit.svg"
        },
        {
          "id": "eggzibit-open",
          "title": "eggzibit",
          "icon": "media/eggzibit-open.svg"
        }
      ]
    },
    "views": {
      "eggzibit": [
        {
          "id": "eggzibit.list",
          "name": "eggzibit",
          "type": "webview",
          "when": "!eggzibit.hasPages"
        }
      ],
      "eggzibit-open": [
        {
          "id": "eggzibit.listOpen",
          "name": "eggzibit",
          "type": "webview",
          "when": "eggzibit.hasPages"
        }
      ]
    },
    "commands": [
      { "command": "eggzibit.open", "title": "Open Page…", "category": "eggzibit", "icon": "$(preview)" },
      { "command": "eggzibit.openSource", "title": "Open HTML Source", "category": "eggzibit", "icon": "$(code)" },
      { "command": "eggzibit.delete", "title": "Delete", "category": "eggzibit" },
      { "command": "eggzibit.refresh", "title": "Refresh", "category": "eggzibit", "icon": "$(refresh)" }
    ],
    "menus": {
      "view/title": [
        { "command": "eggzibit.refresh", "when": "view =~ /^eggzibit\\.list/", "group": "navigation@1" }
      ],
      "webview/context": [
        { "command": "eggzibit.open", "when": "webviewId =~ /^eggzibit\\.list/ && webviewSection == 'page'", "group": "1_open@1" },
        { "command": "eggzibit.openSource", "when": "webviewId =~ /^eggzibit\\.list/ && webviewSection == 'page'", "group": "1_open@2" },
        { "command": "eggzibit.delete", "when": "webviewId =~ /^eggzibit\\.list/ && webviewSection == 'page'", "group": "9_delete@1" }
      ],
      "commandPalette": [
        { "command": "eggzibit.delete", "when": "false" }
      ]
    }
  },
  "scripts": {
    "compile": "npm run compile --workspace eggzibit && tsc -p ./ && tsc -p tsconfig.webview.json && node scripts/build.mjs",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "eggzibit": "*",
    "baukasten-ui": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  }
}
