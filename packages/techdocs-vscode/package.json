{
  "name": "techdocs-vscode",
  "displayName": "techdocs",
  "description": "Pages agents publish into the workspace's .techdocs/ directory, listed, filtered and rendered in the editor's theme through baukasten's design tokens.",
  "version": "0.1.1",
  "private": true,
  "publisher": "praisethemoon",
  "author": {
    "name": "Soulaymen Chouri",
    "email": "doit@praisethemoon.org"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "techdocs",
          "title": "techdocs",
          "icon": "media/techdocs.svg"
        }
      ]
    },
    "views": {
      "techdocs": [
        {
          "id": "techdocs.list",
          "name": "techdocs",
          "type": "webview"
        }
      ]
    },
    "commands": [
      { "command": "techdocs.open", "title": "Open Page…", "category": "techdocs", "icon": "$(preview)" },
      { "command": "techdocs.openSource", "title": "Open HTML Source", "category": "techdocs", "icon": "$(code)" },
      { "command": "techdocs.delete", "title": "Delete", "category": "techdocs" },
      { "command": "techdocs.refresh", "title": "Refresh", "category": "techdocs", "icon": "$(refresh)" }
    ],
    "menus": {
      "view/title": [
        { "command": "techdocs.refresh", "when": "view =~ /^techdocs\\.list/", "group": "navigation@1" }
      ],
      "webview/context": [
        { "command": "techdocs.open", "when": "webviewId =~ /^techdocs\\.list/ && webviewSection == 'page'", "group": "1_open@1" },
        { "command": "techdocs.openSource", "when": "webviewId =~ /^techdocs\\.list/ && webviewSection == 'page'", "group": "1_open@2" },
        { "command": "techdocs.delete", "when": "webviewId =~ /^techdocs\\.list/ && webviewSection == 'page'", "group": "9_delete@1" }
      ],
      "commandPalette": [
        { "command": "techdocs.delete", "when": "false" }
      ]
    }
  },
  "scripts": {
    "compile": "npm run compile --workspace techdocs && tsc -p ./ && tsc -p tsconfig.webview.json && node scripts/build.mjs",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "techdocs": "*",
    "baukasten-ui": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  }
}
