{
  "name": "artifacts-vscode",
  "displayName": "Artifacts",
  "description": "Pages agents publish into the workspace's .artifact/ directory, listed and rendered in the editor's theme through baukasten's design tokens.",
  "version": "0.1.0",
  "private": true,
  "publisher": "praisethemoon",
  "author": {
    "name": "Soulaymen Chouri",
    "email": "doit@praisethemoon.org"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "artifacts",
          "title": "Artifacts",
          "icon": "media/artifacts.svg"
        }
      ]
    },
    "views": {
      "artifacts": [
        {
          "id": "artifacts.list",
          "name": "Artifacts"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "artifacts.list",
        "contents": "No artifacts yet. An agent publishes one with the artifact_publish tool of the artifacts MCP server: an HTML page with a title and a description, saved under .artifact/.",
        "when": "workspaceFolderCount > 0"
      },
      {
        "view": "artifacts.list",
        "contents": "Open a folder to see its artifacts.",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "commands": [
      { "command": "artifacts.open", "title": "Open Artifact…", "category": "Artifacts", "icon": "$(preview)" },
      { "command": "artifacts.openSource", "title": "Open HTML Source", "category": "Artifacts", "icon": "$(code)" },
      { "command": "artifacts.delete", "title": "Delete", "category": "Artifacts" },
      { "command": "artifacts.refresh", "title": "Refresh", "category": "Artifacts", "icon": "$(refresh)" }
    ],
    "menus": {
      "view/title": [
        { "command": "artifacts.refresh", "when": "view == artifacts.list", "group": "navigation@1" }
      ],
      "view/item/context": [
        { "command": "artifacts.openSource", "when": "view == artifacts.list && viewItem == artifact", "group": "inline@1" },
        { "command": "artifacts.openSource", "when": "view == artifacts.list && viewItem == artifact", "group": "1_open@1" },
        { "command": "artifacts.delete", "when": "view == artifacts.list && viewItem == artifact", "group": "9_delete@1" }
      ],
      "commandPalette": [
        { "command": "artifacts.delete", "when": "false" }
      ]
    }
  },
  "scripts": {
    "compile": "npm run compile --workspace artifacts && tsc -p ./ && node scripts/build.mjs",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "artifacts": "*",
    "baukasten-ui": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  }
}
