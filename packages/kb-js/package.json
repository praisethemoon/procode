{
  "name": "kb-js",
  "displayName": "kb-js",
  "description": "Typed reader for the kb knowledge base: shells out to the kb CLI and parses --json. It does not reimplement retrieval (index-api.md §10).",
  "version": "0.2.0",
  "private": true,
  "publisher": "praisethemoon",
  "author": {
    "name": "Soulaymen Chouri",
    "email": "doit@praisethemoon.org"
  },
  "license": "MIT",
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./pure": {
      "types": "./out/pure.d.ts",
      "default": "./out/pure.js"
    }
  },
  "files": [
    "out",
    "pure.js",
    "pure.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
