{
  "name": "lap-vscode",
  "displayName": "Lap History",
  "description": "Visualizes lap fine-grained edit history: sessions, commits with their intent and behavior, live as the agent works.",
  "version": "0.1.1",
  "private": true,
  "publisher": "praisethemoon",
  "author": {
    "name": "Soulaymen Chouri",
    "email": "doit@praisethemoon.org"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.lap/log.jsonl",
    "workspaceContains:.lap/log/main.000001.jsonl",
    "onView:lapHistory"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lap-explorer",
          "title": "Lap",
          "icon": "media/lap.svg"
        }
      ]
    },
    "views": {
      "lap-explorer": [
        {
          "id": "lapHistory",
          "name": "History",
          "type": "webview",
          "icon": "media/lap.svg"
        }
      ]
    },
    "configuration": {
      "title": "Lap",
      "properties": {
        "lap.path": {
          "type": "string",
          "default": "",
          "description": "The lap executable, for branches, references and originals. Empty uses the Board's coboard.lapPath when set, else lap on PATH."
        }
      }
    },
    "commands": [
      {
        "command": "lap.refresh",
        "title": "Lap: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "lap.toggleGrouping",
        "title": "Lap: Toggle Session Grouping / Raw List",
        "icon": "$(list-tree)"
      },
      {
        "command": "lap.showCommit",
        "title": "Lap: Show Commit"
      },
      {
        "command": "lap.collapseAll",
        "title": "Lap: Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "lap.revealCommit",
        "title": "Lap: Reveal Commit"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lap.refresh",
          "when": "view == lapHistory",
          "group": "navigation@2"
        },
        {
          "command": "lap.toggleGrouping",
          "when": "view == lapHistory",
          "group": "navigation@1"
        },
        {
          "command": "lap.collapseAll",
          "when": "view == lapHistory",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "lap.showCommit",
          "when": "false"
        },
        {
          "command": "lap.collapseAll",
          "when": "false"
        },
        {
          "command": "lap.revealCommit",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && tsc -p tsconfig.webview.json && node scripts/build.mjs",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "baukasten-ui": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
